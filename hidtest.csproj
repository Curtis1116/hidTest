<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 使用 console 子系統，命令列模式才能讓 shell 正常等待與接收輸出；
         無參數啟動圖形介面時，程式會自行隱藏並卸離主控台視窗。 -->
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>hidtest</AssemblyName>
    <RootNamespace>HidTest</RootNamespace>
    <!-- .NET Framework 使用系統已安裝的 4.8 執行階段，不攜帶 runtime。 -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <!-- Release 交付物只保留 exe；Costura 會把託管相依 DLL 嵌入其中。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- 即使增量建置曾被中斷，也不讓已嵌入的 DLL 留在 Release 交付目錄。 -->
  <Target Name="RemoveEmbeddedDependencyFiles" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <EmbeddedDependencyFiles Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Delete Files="@(EmbeddedDependencyFiles)" />
  </Target>

</Project>
